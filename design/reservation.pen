                        },
                        {
                          "type": "frame",
                          "id": "jmdD4",
                          "name": "Register UX notes — not page content",
                          "width": "fill_container",
                          "fill": "$ss-surface",
                          "cornerRadius": 6,
                          "layout": "vertical",
                          "gap": 12,
                          "padding": 20,
                          "children": [
                            {
                              "type": "text",
                              "id": "CLUck",
                              "name": "Scope",
                              "fill": "$ss-secondary",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Register desktop and mobile only. No navbar, matching the requested authentication layout. Existing Login, Discovery and booking designs are unchanged. Verify is the next design task, not a new screen created here.",
                              "lineHeight": 1.6,
                              "fontFamily": "$ss-font",
                              "fontSize": 14,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "JZikI",
                              "name": "Google and account identity",
                              "fill": "$ss-secondary",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Continue with Google reuses the official Google G button. A trusted verified Google email needs no duplicate verification email. Automatic linking only applies when both identities have the same verified email, preserving reservations and permissions. New accounts remain attendees; no role selector or admin signup is exposed.",
                              "lineHeight": 1.6,
                              "fontFamily": "$ss-font",
                              "fontSize": 14,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "a452W",
                              "name": "Email signup and handoff",
                              "fill": "$ss-secondary",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Collect full name, email and password. After authoritative account creation, continue to email verification when required and preserve the intended event / reservation destination. Booking still requires the user’s explicit action after eligibility checks. Do not report account creation or email delivery success before it is known.",
                              "lineHeight": 1.6,
                              "fontFamily": "$ss-font",
                              "fontSize": 14,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "aB5eD",
                              "name": "Validation and security",
                              "fill": "$ss-secondary",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Use name / email / new-password autocomplete, password-manager support and a 44px show/hide control. Show useful backend validation without inventing a new numeric password policy. Generic strength guidance is intentionally used here. Preserve non-sensitive input after recoverable failures, announce errors, prevent duplicate submissions and restore controls when a request fails. Do not store passwords in browser storage.",
                              "lineHeight": 1.6,
                              "fontFamily": "$ss-font",
                              "fontSize": 14,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "t6kL1Y",
                              "name": "Preview and review",
                              "fill": "$ss-secondary",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Alex Tan and alex@example.com are illustrative input—not demo credentials. These are editable Pen.dev designs, not implemented signup / Google OAuth. Reuse the Midnight Social palette and 6px controls. No application code, dependencies, schemas or project documentation are changed.",
                              "lineHeight": 1.6,
                              "fontFamily": "$ss-font",
                              "fontSize": 14,
                              "fontWeight": "normal"
                            }
                          ]
                        }
