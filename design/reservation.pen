              "children": [
                {
                  "type": "text",
                  "id": "EI23c",
                  "name": "Recommendation",
                  "fill": "$ss-text",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Use ticket / people / lock / check icons to differentiate booking states. Keep one readable contextual badge: Registered replaces availability, and cancelled events remain excluded. Color is reinforcement, never the only signal.",
                  "lineHeight": 1.5,
                  "fontFamily": "$ss-font",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "QvumE",
                  "name": "Bookmark distinction",
                  "fill": "$ss-text",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "A bookmark means interest, not ownership of a place. “Saved” and “Registered” must never use the same icon or wording. If saving is approved later, its 44×44 control is a separate action and would require revisiting the current whole-row-link / no-extra-actions rule.",
                  "lineHeight": 1.5,
                  "fontFamily": "$ss-font",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "aunBT",
                  "name": "Accessibility",
                  "fill": "$ss-text",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Status icons are decorative when their visible label communicates the same information. An icon-only bookmark requires an accessible name, a pressed state and visible keyboard focus. Do not make informational status badges look like buttons.",
                  "lineHeight": 1.5,
                  "fontFamily": "$ss-font",
                  "fontSize": 14,
                  "fontWeight": "normal"
                }
              ]
            }
