              "fill": "$ss-text",
              "content": "Share Event / Public link only",
              "fontFamily": "$ss-font",
              "fontSize": 20,
              "fontWeight": "600"
            },
            {
              "id": "Yxksx",
              "type": "ref",
              "ref": "p6e24d",
              "name": "Existing Copy Link fallback — success-page sharing",
              "width": 560
            },
            {
              "type": "frame",
              "id": "W5F4X",
              "name": "Booking Success behavior — outside actual pages",
              "width": "fill_container",
              "fill": "$ss-surface",
              "cornerRadius": 6,
              "layout": "vertical",
              "gap": 14,
              "padding": 24,
              "children": [
                {
                  "type": "text",
                  "id": "a79utV",
                  "name": "Confirmation",
                  "fill": "$ss-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Show this page only after the backend accepts the reservation and returns its unique booking reference. Never infer success from a click, optimistic state or an email send attempt. Reloading or revisiting the page must not repeat the booking mutation. This design is not proof of a real booking.",
                  "lineHeight": 1.6,
                  "fontFamily": "$ss-font",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "PSZ9z",
                  "name": "Destinations",
                  "fill": "$ss-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "View My Reservation opens the selected reservation’s dedicated details, not this success page again. My Reservations navigation opens the booking list. Explore more events returns to the approved date-led Discovery page. A login or verification flow never creates another reservation automatically.",
                  "lineHeight": 1.6,
                  "fontFamily": "$ss-font",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "c05mn",
                  "name": "Sharing",
                  "fill": "$ss-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Share Event uses the public event URL only, with native sharing preferred and Copy Link as fallback. Never include WC-7K4M9Q or any private reservation identifiers in a shared link. Link copied is shown only after clipboard success; native share opening does not prove completed sharing.",
                  "lineHeight": 1.6,
                  "fontFamily": "$ss-font",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "kHvWv",
                  "name": "Email and statuses",
                  "fill": "$ss-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "No Email sent claim appears on the page. Email delivery can fail or be delayed without invalidating the confirmed reservation. Current event information and reservation details remain on the site. Do not show a confirmed active place if authoritative reservation state says it was cancelled.",
                  "lineHeight": 1.6,
                  "fontFamily": "$ss-font",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
