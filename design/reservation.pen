                },
                {
                  "id": "eXt9C",
                  "type": "ref",
                  "ref": "sKMRZ",
                  "name": "Mobile reservation bar / Registration Closed · linked reference",
                  "width": 390
                }
              ]
            },
            {
              "type": "frame",
              "id": "Yy8ax",
              "name": "Handoff notes — not page content",
              "width": "fill_container",
              "fill": "$ss-surface",
              "cornerRadius": 6,
              "layout": "vertical",
              "gap": 14,
              "padding": 24,
              "children": [
                {
                  "type": "text",
                  "id": "G2zqT9",
                  "name": "Scope",
                  "fill": "$ss-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "My Reservations Active / History and both empty states are shown for desktop and mobile. Event Details covers the eligible available state at both widths; alternative action components cover full, closed, registered and cancelled states. Reservation Details and Booking Success pages are not designed in this task.",
                  "lineHeight": 1.6,
                  "fontFamily": "$ss-font",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "rlEa8",
                  "name": "Sticky behavior",
                  "fill": "$ss-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Mobile uses one persistent bottom reservation bar while scrolling; main content has 160px bottom padding. The canvas shows its full-page position as a static specimen. No competing Reserve button appears within the mobile page body. Registered / unavailable states replace the bar action.",
                  "lineHeight": 1.6,
                  "fontFamily": "$ss-font",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "DRFkG",
                  "name": "Descriptions and booking",
                  "fill": "$ss-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Read full description opens a centered desktop dialog or larger mobile dialog without expanding page content. Trap and restore focus, provide keyboard close, keep the background inert. Confirm Reservation submits once, shows loading, and waits for server acceptance. Full / closed / cancelled / started / duplicate / unverified / network errors must remain distinct. Refresh persistent availability after a capacity race; no false success page.",
                  "lineHeight": 1.6,
                  "fontFamily": "$ss-font",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "T0yNmO",
                  "name": "Availability rules",
                  "fill": "$ss-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Sample capacity is 20 with 3 remaining: positive, ≤5 and ≤20%. Only available, open and not-already-registered attendees see the low-seat message. All deadlines and schedules use WIB, stored instants remain UTC. The ordinary self-cancellation cutoff is strictly before 6 Nov 2026, 09:00 WIB. Affected-attendee change exceptions remain enforced by the PRD.",
                  "lineHeight": 1.6,
                  "fontFamily": "$ss-font",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "t1a3T",
                  "name": "Media maps and contact",
                  "fill": "$ss-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Realistic workshop photography is reused from the approved discovery design. This example intentionally has no optional map embed: full address and Open in Google Maps remain available. Venue name, street address and .example organizer contact are illustrative demo content and must be replaced / confirmed before production. Contact is organization-wide configuration, not an individual admin login.",
                  "lineHeight": 1.6,
                  "fontFamily": "$ss-font",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "F0pCi",
                  "name": "Sharing",
                  "fill": "$ss-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Prefer native sharing when supported; Copy Link is the fallback. Show Link copied only after a successful clipboard write. Opening native share is not proof of completed sharing. Public URLs must exclude reservation references and private details.",
                  "lineHeight": 1.6,
                  "fontFamily": "$ss-font",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "pNGMj",
                  "name": "Visual review",
                  "fill": "$ss-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Midnight Social colors, Inter, 6px controls / cards / dialogs and 5px labels reflect the latest canvas preference. Supporting tokens remain review-stage. Pale default boundaries still need accessibility review; verify keyboard navigation, screen-reader labels and contrast during implementation. Original wireframes, existing pages, code and documents are unchanged.",
                  "lineHeight": 1.6,
                  "fontFamily": "$ss-font",
                  "fontSize": 14,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        },
        {
          "type": "frame",
          "id": "rMpC8",
          "name": "Authentication — Login Components & State Review",
          "width": 1440,
          "fill": "$ss-background",
          "layout": "vertical",
          "gap": 24,
          "padding": 32,
          "children": [
            {
              "type": "text",
              "id": "kxR9p",
              "name": "Component board heading",
              "fill": "$ss-text",
              "content": "Authentication / Login",
              "fontFamily": "$ss-font",
              "fontSize": 24,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "g19s5l",
              "name": "Scope note",
              "fill": "$ss-secondary",
              "content": "Login only · Google + email/password · Register and Verify are destinations, not designed screens in this task.",
              "fontFamily": "$ss-font",
              "fontSize": 14,
              "fontWeight": "normal"
            },
            {
              "id": "R9fSS",
              "type": "ref",
              "ref": "D1jiaL",
              "name": "Auth button / Continue with Google · linked reference",
              "width": 440,
              "height": 48
            },
            {
              "id": "tMlbO",
              "type": "ref",
              "ref": "L02kD",
              "name": "Auth input / Password · linked reference",
              "width": 440,
              "height": 48
            },
            {
              "id": "RaXdo",
              "type": "ref",
              "ref": "fIkIb",
              "name": "Login / Form · linked reference",
              "width": 440
            },
            {
              "type": "frame",
              "id": "yM0cE",
              "name": "Login UX and accessibility notes — outside page frames",
              "width": "fill_container",
              "fill": "$ss-surface",
              "cornerRadius": 6,
              "layout": "vertical",
              "gap": 14,
              "padding": 24,
              "children": [
                {
                  "type": "text",
                  "id": "B6KGIJ",
                  "name": "Scope and destinations",
                  "fill": "$ss-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Only Login is designed here. Create account leads to Register; Forgot password? leads to recovery. Register, Verify, recovery pages and success destinations are references, not new screens. Shared navigation keeps Events and My Reservations visible. Guests selecting My Reservations return after authentication.",
                  "lineHeight": 1.6,
                  "fontFamily": "$ss-font",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "d94y0",
                  "name": "Authentication behavior",
                  "fill": "$ss-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Email/password and Google are alternative methods. Preserve the intended event / reservation destination across login and verification when required. Never automatically reserve a place after authentication. Unverified-email eligibility blocks booking, not automatically every account view. Trusted verified Google emails do not need another local verification email. Verified same-email linking remains server-owned.",
                  "lineHeight": 1.6,
                  "fontFamily": "$ss-font",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "NpVQD",
                  "name": "Failure and loading",
                  "fill": "$ss-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Incorrect credentials use a generic error that does not expose account existence. Keep validation, network/server and Google provider failures distinguishable. Preserve useful input during recoverable failure, announce errors, prevent repeated submissions while pending, and restore controls after a failure. Native Google flow dismissal is not successful authentication.",
                  "lineHeight": 1.6,
                  "fontFamily": "$ss-font",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "VX0s5",
                  "name": "Accessibility and security",
                  "fill": "$ss-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Email uses email autocomplete; password uses current-password autocomplete and a real masked field. Show/hide is a 44×44px control with an accessible name and updated pressed state. Support Enter-to-submit, sensible tab order, password managers and visible lavender focus. Never store passwords or session tokens in browser storage. Validate control boundary contrast before implementation.",
                  "lineHeight": 1.6,
                  "fontFamily": "$ss-font",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "UowBY",
                  "name": "Visual and sample notes",
                  "fill": "$ss-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Inter + Midnight Social, 6px controls, off-white primary button. Continue with Google uses the official full-color Google G asset, kept at its original proportions. Verify provider button branding rules during implementation. alex@example.com is illustrative input, not a real demo credential. The preverified sample attendee credentials must be supplied separately; no password was invented. Original pages, wireframes, code and project documents are unchanged.",
                  "lineHeight": 1.6,
                  "fontFamily": "$ss-font",
                  "fontSize": 14,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        },
        {
          "type": "frame",
          "id": "F1AdR",
          "name": "Booking Success — Reusable Components & UX Review",
          "width": 1440,
          "fill": "$ss-background",
