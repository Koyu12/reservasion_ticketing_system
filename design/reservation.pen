            {
              "type": "frame",
              "id": "blzdI",
              "name": "UX notes — outside actual page frames",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 16,
              "children": [
                {
                  "type": "text",
                  "id": "uYDaw",
                  "name": "Structure",
                  "fill": "#292929",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Separate Active and History views are shown at 1440px and 390px. These are states of My Reservations, not four new routes. Reuse the same card component and responsive navigation. No cover images, promotional banners, date rails or new filters on this page.",
                  "lineHeight": 1.5,
                  "fontFamily": "Inter",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "Q4481",
                  "name": "Reservation status",
                  "fill": "#292929",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Confirmed and Cancelled are the reservation statuses. Past event is an event-time context, not a new reservation status. Organizer cancellation uses a distinct notice; user cancellation retains an ordinary Cancelled badge. The subtle organizer-cancellation fill is grayscale here and will become muted red in high fidelity.",
                  "lineHeight": 1.5,
                  "fontFamily": "Inter",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "Arz8l",
                  "name": "Event changes",
                  "fill": "#292929",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Current revised schedule appears in the card body. The plain change summary sits after a divider without a tinted background. Affected attendees retain their special self-cancellation window until the revised start; details and actions belong to Reservation Details.",
                  "lineHeight": 1.5,
                  "fontFamily": "Inter",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "fElbz",
                  "name": "Navigation and cancellation",
                  "fill": "#292929",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "View reservation opens the dedicated Reservation Details page, not Booking Success. Cancellation controls and confirmation belong to that flow. After successful cancellation, My Reservations shows a toast and persistent Cancelled state in History. Guests pass through authentication and return to their intended destination.",
                  "lineHeight": 1.5,
                  "fontFamily": "Inter",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "evmfK",
                  "name": "Empty and loading states",
                  "fill": "#292929",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Keep navigation, page heading and Active / History tabs visible. Replace the selected tab’s list with its appropriate empty component and Explore events link; do not show the empty state while data is still loading or when loading fails. Handle error and retry separately.",
                  "lineHeight": 1.5,
                  "fontFamily": "Inter",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "E7rnJ",
                  "name": "Sample and review status",
                  "fill": "#292929",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Illustrative snapshot: 29 Oct 2026. November events are upcoming; 17 Oct is historical. Sample ordering is illustrative, not a new sorting contract. All UI copy is English; event times are WIB. Review wireframes before applying Midnight Social high-fidelity colors. No documentation, existing pages, or application code changed.",
                  "lineHeight": 1.5,
                  "fontFamily": "Inter",
                  "fontSize": 14,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        }
      ]
    },
