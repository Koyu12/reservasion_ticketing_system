                  "id": "ydzeA",
                  "name": "Sample and visual scope",
                  "fill": "$ss-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "WC-7K4M9Q is an illustrative reference, not an issued booking. Event date and venue match the current Event Details sample. The .example share URL is placeholder configuration. Midnight Social, 6px corners, shared navigation/actions and reusable date tiles are retained. No QR, barcode, payment, calendar export, confetti, code or documentation changes.",
                  "lineHeight": 1.6,
                  "fontFamily": "$ss-font",
                  "fontSize": 14,
                  "fontWeight": "normal"
                }
              ]
            }
